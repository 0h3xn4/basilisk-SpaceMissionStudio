#!/bin/sh
# postinst: runs after dpkg unpacks this package. Everything the tool needs
# is in the package itself (/opt/spacemissionstudio/python: Python,
# Basilisk, the Python packages, the support data and the Earth orientation
# files), so nothing is installed or downloaded here.
set -e

case "$1" in
    configure)
        # Packages up to 1.1.0 created a virtual environment here at
        # install time; dpkg does not know about it, so remove it.
        rm -rf /opt/spacemissionstudio/venv

        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
        fi
        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q /usr/share/icons/hicolor >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
