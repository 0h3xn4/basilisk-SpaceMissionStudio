#!/bin/sh
# postrm: runs after dpkg removes this package's files. dpkg removes only
# the files the package shipped; anything else under /opt/spacemissionstudio
# (bytecode Python wrote when the tool was run as root, a virtual
# environment left by a package up to 1.1.0) would keep the folder.
set -e

case "$1" in
    remove|purge)
        rm -rf /opt/spacemissionstudio
        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
