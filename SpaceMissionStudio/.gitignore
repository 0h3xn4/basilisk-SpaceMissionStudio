__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/
build/
dist/

# Space-weather cache (fetched/generated at runtime, not checked in)
.cache/

# Coverage data (compliance/tools/metrics.py, CI)
.coverage
.coverage.*
coverage.json

# The .deb launcher (the repository root ignores every bin/ folder).
!packaging/deb/usr/bin/
# Built by packaging/bundle_python.py for the Windows setup, and its download cache.
packaging/windows/python/
packaging/.python-build-cache/

# IDM-CIC models (.idm, any case) are CNES-format files that may hold real
# project data: never committed, except the small hand-written synthetic
# fixtures of the importer's tests (docs/developer/idm-cic-integration.md).
*.[iI][dD][mM]
!tests/data/idm/*.[iI][dD][mM]

# scripts/network_audit.py output
network-audit/
